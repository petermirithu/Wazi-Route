<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="relative isolate overflow-hidden bg-base-200" aria-labelledby="hero-title">
    <div class="wazi-pattern-light absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-[1440px] items-center gap-12 px-5 py-12 sm:px-8 sm:py-16 lg:grid-cols-[1fr_1.05fr] lg:px-12 lg:py-20">
      <div class="max-w-2xl">
        <h1
          id="hero-title"
          class="text-[clamp(2.65rem,6.4vw,6rem)] leading-[0.98] font-bold tracking-[-0.045em] text-primary"
        >
          Know the road.<br /><span class="text-secondary">Choose your way.</span>
        </h1>
        <p class="mt-7 max-w-xl text-base leading-8 text-base-content/75 sm:text-lg">
          Wazi Route looks beyond minutes and kilometres—bringing your car, road conditions, hills, and local knowledge into every route choice.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <.link
            id="hero-get-started"
            href={~p"/users/register"}
            class="group inline-flex min-h-14 items-center gap-4 rounded-lg bg-secondary px-6 py-3 text-sm font-bold text-secondary-content shadow-[5px_5px_0_#273f30] transition hover:-translate-y-1 hover:shadow-[7px_7px_0_#273f30] motion-reduce:transform-none"
          >
            Join the journey
            <.icon
              name="hero-arrow-up-right"
              class="size-5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </.link>
          <a
            id="explore-how-it-works"
            href="#how-it-works"
            class="inline-flex min-h-12 items-center gap-2 px-3 text-sm font-bold text-primary hover:text-secondary"
          >
            See how it works <.icon name="hero-arrow-down" class="size-4" />
          </a>
        </div>
        <div class="mt-11 flex flex-wrap gap-x-8 gap-y-3 border-t border-primary/20 pt-6 text-xs font-medium text-base-content/65">
          <span class="flex items-center gap-2"><.icon
            name="hero-map-pin"
            class="size-4 text-secondary"
          /> Nairobi pilot</span>
          <span class="flex items-center gap-2"><.icon
            name="hero-sparkles"
            class="size-4 text-secondary"
          /> Built with local context</span>
        </div>
      </div>

      <div class="relative lg:pl-4">
        <div
          class="absolute -top-6 -right-6 hidden size-32 grid-cols-4 gap-2 lg:grid"
          aria-hidden="true"
        >
          <%= for _ <- 1..16 do %>
            <span class="size-2.5 rounded-full bg-accent"></span>
          <% end %>
        </div>
        <figure
          id="hero-photograph"
          class="relative h-[420px] overflow-hidden rounded-[2rem_2rem_8rem_2rem] border-[6px] border-base-100 bg-primary shadow-xl sm:h-[560px] lg:h-[650px]"
        >
          <img
            src={~p"/images/forest-road.jpg"}
            srcset={"#{~p"/images/forest-road-small.jpg"} 900w, #{~p"/images/forest-road.jpg"} 1800w"}
            sizes="(max-width: 1023px) 100vw, 52vw"
            alt="An open road winding through a densely wooded landscape, seen from above"
            width="1800"
            height="1011"
            fetchpriority="high"
            class="size-full object-cover object-[58%_center]"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-neutral/75 via-transparent to-transparent"
            aria-hidden="true"
          >
          </div>
          <figcaption class="absolute right-8 bottom-9 left-8 sm:right-12 sm:bottom-12 sm:left-12">
            <span class="inline-block rounded-full bg-accent px-3 py-1 text-xs font-bold text-accent-content">Your route, reconsidered</span>
            <p class="mt-4 max-w-sm text-2xl leading-tight font-semibold text-white sm:text-4xl">
              A better drive can change the whole day.
            </p>
          </figcaption>
        </figure>
        <p id="preview-caption" class="mt-3 text-right text-[10px] leading-5 text-base-content/60">
          Photography for inspiration, not live route guidance.
        </p>
      </div>
    </div>
  </section>

  <div id="local-context" class="bg-primary text-primary-content">
    <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-5 px-5 py-5 sm:px-8 lg:px-12">
      <p class="text-sm font-bold">Starting where our story began.</p>
      <p class="flex flex-wrap items-center gap-3 text-xs text-primary-content/70 sm:gap-5">
        <span>Ruaka</span><span class="text-accent">◆</span><span>Redhill</span><span class="text-accent">◆</span><span>ABC</span><span class="text-accent">◆</span><span>Loresho</span>
      </p>
    </div>
  </div>

  <section
    id="why-wazi"
    class="relative overflow-hidden bg-base-100 py-20 lg:py-28"
    aria-labelledby="features-title"
  >
    <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
      <div class="grid gap-7 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-secondary">Why Wazi Route</p>
        <div>
          <h2
            id="features-title"
            class="text-4xl leading-[1.08] font-bold tracking-[-0.035em] text-primary sm:text-5xl lg:text-6xl"
          >
            Every road has a story.<br /><span class="text-secondary">Your car does too.</span>
          </h2>
          <p class="mt-6 max-w-2xl text-sm leading-7 text-base-content/70 sm:text-base">
            The fastest line on a map can miss what matters on the ground. Wazi brings the character of the road into the decision.
          </p>
        </div>
      </div>

      <div id="feature-list" class="mt-14 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        <article
          id="feature-vehicle"
          class="group rounded-2xl border border-base-300 bg-base-200 p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-lg motion-reduce:transform-none"
        >
          <div class="flex size-12 items-center justify-center rounded-xl bg-primary text-primary-content">
            <.icon name="hero-truck" class="size-6" />
          </div>
          <p class="mt-8 text-xs font-bold text-secondary">01 / YOUR CAR</p>
          <h3 class="mt-3 text-xl font-bold text-primary">Built around what you drive.</h3>
          <p class="mt-3 text-sm leading-7 text-base-content/70">
            Low clearance, manual gearbox, or a preference for gentler roads—your vehicle changes the choice.
          </p>
        </article>
        <article
          id="feature-roads"
          class="group rounded-2xl border border-base-300 bg-base-100 p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-lg motion-reduce:transform-none"
        >
          <div class="flex size-12 items-center justify-center rounded-xl bg-secondary text-secondary-content">
            <.icon name="hero-map" class="size-6" />
          </div>
          <p class="mt-8 text-xs font-bold text-secondary">02 / THE ROAD</p>
          <h3 class="mt-3 text-xl font-bold text-primary">More than a line on a map.</h3>
          <p class="mt-3 text-sm leading-7 text-base-content/70">
            Road surfaces, awkward bumps, and familiar trouble spots belong beside distance and time.
          </p>
        </article>
        <article
          id="feature-hills"
          class="group rounded-2xl border border-base-300 bg-base-200 p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-lg motion-reduce:transform-none"
        >
          <div class="flex size-12 items-center justify-center rounded-xl bg-accent text-accent-content">
            <.icon name="hero-arrow-trending-up" class="size-6" />
          </div>
          <p class="mt-8 text-xs font-bold text-secondary">03 / THE CLIMB</p>
          <h3 class="mt-3 text-xl font-bold text-primary">Skip the uphill stop-start.</h3>
          <p class="mt-3 text-sm leading-7 text-base-content/70">
            A hill isn't always the problem. Traffic on it might be. Context makes that difference visible.
          </p>
        </article>
        <article id="feature-evidence" class="wazi-pattern rounded-2xl p-6 text-primary-content">
          <div class="flex size-12 items-center justify-center rounded-xl bg-base-100/10">
            <.icon name="hero-information-circle" class="size-6 text-accent" />
          </div>
          <p class="mt-8 text-xs font-bold text-accent">04 / HONEST DATA</p>
          <h3 class="mt-3 text-xl font-bold">Clear about what we know.</h3>
          <p class="mt-3 text-sm leading-7 text-primary-content/70">
            Good guidance includes the gaps. Unknown roads stay unknown until better information arrives.
          </p>
          <a
            href="#coverage-note"
            class="mt-5 inline-flex items-center gap-2 text-xs font-bold text-accent hover:text-white"
          >Our coverage promise <.icon name="hero-arrow-right" class="size-4" /></a>
        </article>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="bg-base-200 py-20 lg:py-28" aria-labelledby="how-title">
    <div class="mx-auto grid max-w-[1440px] items-center gap-14 px-5 sm:px-8 lg:grid-cols-[.9fr_1.1fr] lg:px-12">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-secondary">
          From context to confidence
        </p>
        <h2
          id="how-title"
          class="mt-5 text-4xl leading-[1.08] font-bold tracking-[-0.035em] text-primary sm:text-5xl lg:text-6xl"
        >
          Three steps.<br />One better choice.
        </h2>
        <ol id="journey-steps" class="mt-10 space-y-4">
          <li class="grid grid-cols-[3.25rem_1fr] gap-4 rounded-xl bg-base-100 p-5">
            <span class="text-2xl font-bold text-secondary">01</span><div>
              <h3 class="font-bold text-primary">Tell us about your drive.</h3><p class="mt-2 text-sm leading-6 text-base-content/65">
                Your destination, vehicle, and what you'd rather avoid.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[3.25rem_1fr] gap-4 rounded-xl bg-base-100 p-5">
            <span class="text-2xl font-bold text-secondary">02</span><div>
              <h3 class="font-bold text-primary">Compare what really differs.</h3><p class="mt-2 text-sm leading-6 text-base-content/65">
                See time alongside surfaces, climbs, and known road reports.
              </p>
            </div>
          </li>
          <li class="grid grid-cols-[3.25rem_1fr] gap-4 rounded-xl bg-base-100 p-5">
            <span class="text-2xl font-bold text-secondary">03</span><div>
              <h3 class="font-bold text-primary">Choose with confidence.</h3><p class="mt-2 text-sm leading-6 text-base-content/65">
                Take the route that fits you, then help the next driver along.
              </p>
            </div>
          </li>
        </ol>
      </div>

      <aside
        id="drive-example"
        aria-labelledby="drive-example-title"
        class="relative overflow-hidden rounded-[2rem] bg-primary p-7 text-primary-content shadow-xl sm:p-10"
      >
        <div
          class="absolute -right-12 -top-12 size-48 rounded-full border-[32px] border-accent/15"
          aria-hidden="true"
        >
        </div>
        <div class="relative flex items-start justify-between gap-5">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent">
              Morning drive · 7:45
            </p><h3 id="drive-example-title" class="mt-3 text-3xl font-bold">
              Ruaka to the city
            </h3>
          </div>
          <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-base-100/10"><.icon
            name="hero-adjustments-horizontal"
            class="size-6"
          /></span>
        </div>
        <dl class="relative mt-9 space-y-3">
          <div class="rounded-xl border border-primary-content/15 bg-base-100/5 p-5">
            <dt class="flex items-center gap-2 text-xs text-accent">
              <.icon name="hero-key" class="size-4" /> Vehicle
            </dt><dd class="mt-2 font-semibold">Low clearance · Manual</dd>
          </div>
          <div class="rounded-xl border border-primary-content/15 bg-base-100/5 p-5">
            <dt class="flex items-center gap-2 text-xs text-accent">
              <.icon name="hero-map" class="size-4" /> Preference
            </dt><dd class="mt-2 font-semibold">Smoother roads over shortcuts</dd>
          </div>
          <div class="rounded-xl border border-primary-content/15 bg-base-100/5 p-5">
            <dt class="flex items-center gap-2 text-xs text-accent">
              <.icon name="hero-clock" class="size-4" /> Avoid
            </dt><dd class="mt-2 font-semibold">Stop-start traffic on steep climbs</dd>
          </div>
        </dl>
        <p id="drive-example-note" class="relative mt-6 text-xs leading-6 text-primary-content/55">
          Illustrative preferences, not a live route. This is the experience we're building.
        </p>
      </aside>
    </div>
  </section>

  <section id="our-story" class="bg-base-100 py-20 lg:py-28" aria-labelledby="story-title">
    <div class="mx-auto grid max-w-[1440px] items-center gap-12 px-5 sm:px-8 lg:grid-cols-[1.05fr_.95fr] lg:px-12">
      <figure
        id="story-photograph"
        class="group relative h-[430px] overflow-hidden rounded-[7rem_2rem_2rem_2rem] bg-primary sm:h-[560px]"
      >
        <img
          src={~p"/images/valley-road.jpg"}
          alt="A narrow road following the curves of a green, rocky valley"
          width="1000"
          height="1150"
          loading="lazy"
          class="size-full object-cover transition duration-700 group-hover:scale-105 motion-reduce:transform-none"
        />
        <div
          class="absolute inset-0 bg-linear-to-t from-neutral/70 via-transparent to-transparent"
          aria-hidden="true"
        >
        </div>
        <figcaption class="absolute right-8 bottom-9 left-8 text-2xl font-bold text-white sm:text-3xl">
          The roads we know<br />shape the routes we trust.
        </figcaption>
      </figure>
      <div class="lg:pl-8">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-secondary">Our story</p>
        <h2
          id="story-title"
          class="mt-5 text-4xl leading-[1.08] font-bold tracking-[-0.035em] text-primary sm:text-5xl lg:text-6xl"
        >
          It started with<br />that hill near ABC.
        </h2>
        <p class="mt-7 max-w-xl text-base leading-8 text-base-content/75">
          A low car. A manual gearbox. A morning commute from Ruaka. When traffic backs up on the hill near ABC, the Loresho turn starts to make much more sense.
        </p>
        <blockquote class="my-8 border-l-4 border-accent pl-6 text-xl leading-relaxed font-bold text-secondary sm:text-2xl">
          Not the shortest route.<br />Just a better drive for you.
        </blockquote>
        <p class="max-w-xl text-sm leading-7 text-base-content/65">
          Wazi Route grew from that everyday decision. We're beginning with Nairobi's northwest corridors and building outward with drivers who know these roads.
        </p>
      </div>
    </div>
  </section>

  <aside id="coverage-note" class="bg-accent text-accent-content">
    <div class="mx-auto flex max-w-[1100px] items-start gap-4 px-5 py-6 text-sm leading-7 sm:px-8">
      <.icon name="hero-information-circle" class="mt-1 size-5 shrink-0" /><p>
        <strong>Our coverage promise:</strong>
        Unknown road conditions won't be labelled smooth or safe. Always follow road signs and use your own judgement.
      </p>
    </div>
  </aside>

  <section
    id="install-help"
    class="bg-base-200 py-16 [&[hidden]]:hidden"
    aria-labelledby="install-title"
  >
    <div class="mx-auto grid max-w-[1180px] items-center gap-10 px-5 sm:px-8 lg:grid-cols-[.8fr_1.2fr] lg:px-12">
      <div class="relative mx-auto flex h-64 w-44 items-center justify-center rounded-[2rem] border-[7px] border-primary bg-base-100 shadow-[12px_12px_0_#e9ad45] lg:h-72 lg:w-48">
        <span class="absolute top-2 h-1.5 w-14 rounded-full bg-primary" aria-hidden="true"></span>
        <img
          src={~p"/images/wazi-mark.png"}
          alt=""
          width="166"
          height="172"
          class="w-20 mix-blend-multiply"
        />
        <span
          class="absolute bottom-2 size-2.5 rounded-full border-2 border-primary"
          aria-hidden="true"
        ></span>
      </div>
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-secondary">
          Take Wazi with you
        </p>
        <h2
          id="install-title"
          class="mt-4 text-3xl leading-tight font-bold text-primary sm:text-4xl"
        >
          Install Wazi Route<br />on your phone.
        </h2>
        <p class="mt-5 max-w-xl text-sm leading-7 text-base-content/70">
          Add Wazi Route to your home screen for quick access and a focused, app-like experience.
        </p>
        <div class="mt-7 grid gap-3 text-sm sm:grid-cols-2">
          <p
            id="ios-install-help"
            class="rounded-xl border border-base-300 bg-base-100 p-4 leading-6"
          >
            <strong class="text-primary">iPhone or iPad</strong><br />Open in Safari, tap Share, then Add to Home Screen.
          </p>
          <p
            id="android-install-help"
            class="rounded-xl border border-base-300 bg-base-100 p-4 leading-6"
          >
            <strong class="text-primary">Android</strong><br />Open in Chrome, then choose Install app or Add to Home screen.
          </p>
        </div>
        <.button
          id="pwa-install"
          hidden
          class="mt-5 inline-flex min-h-12 items-center gap-3 rounded-lg bg-secondary px-5 py-3 text-sm font-bold text-secondary-content transition hover:bg-primary [&[hidden]]:hidden"
        >
          <.icon name="hero-arrow-down-tray" class="size-5" /> Install Wazi Route
        </.button>
        <p
          id="pwa-install-status"
          role="status"
          class="mt-3 text-xs leading-6 text-base-content/65"
        >
        </p>
      </div>
    </div>
  </section>

  <section
    id="coming-soon"
    class="wazi-pattern text-primary-content"
    aria-labelledby="launch-section-title"
  >
    <div class="mx-auto grid max-w-[1440px] items-center gap-8 px-5 py-16 sm:px-8 lg:grid-cols-[1.2fr_.8fr] lg:px-12 lg:py-20">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent">
          A Nairobi beginning. More roads ahead.
        </p><h2
          id="launch-section-title"
          class="mt-4 text-4xl leading-tight font-bold sm:text-5xl"
        >
          Ready for a better<br />way home?
        </h2>
      </div>
      <div class="lg:border-l lg:border-primary-content/20 lg:pl-12">
        <p class="max-w-md text-sm leading-7 text-primary-content/75">
          Join the first Wazi community while route planning and road coverage are being prepared.
        </p><.link
          id="launch-cta"
          href={~p"/users/register"}
          class="mt-6 inline-flex min-h-13 items-center gap-4 rounded-lg bg-accent px-6 py-3 text-sm font-bold text-accent-content transition hover:-translate-y-1 hover:bg-base-100 motion-reduce:transform-none"
        >Create your account <.icon name="hero-arrow-up-right" class="size-5" /></.link>
      </div>
    </div>
  </section>
</Layouts.app>
