<Layouts.app flash={@flash} current_scope={@current_scope} chrome={false}>
  <section id="dashboard-workspace" class="relative h-dvh overflow-hidden bg-base-200">
    <div class="relative h-full">
      <div
        id="dashboard-controls"
        class="wazi-map-controls pointer-events-none absolute inset-x-4 z-[700] flex items-start justify-between gap-4 md:inset-x-6 lg:inset-x-8"
      >
        <.link
          id="dashboard-brand"
          navigate={~p"/dashboard"}
          aria-label="Wazi Route dashboard"
          class="pointer-events-auto inline-flex h-14 items-center gap-2 rounded-2xl border border-base-300/70 bg-base-100/95 px-3 shadow-xl backdrop-blur-xl"
        >
          <img
            src={~p"/images/wazi-mark.png"}
            alt=""
            width="166"
            height="172"
            class="size-10 object-contain mix-blend-multiply"
          />
          <img
            src={~p"/images/wazi-wordmark.png"}
            alt="Wazi Route"
            width="280"
            height="43"
            class="hidden h-auto w-28 object-contain mix-blend-multiply sm:block"
          />
        </.link>

        <details id="profile-menu" class="group pointer-events-auto relative">
          <summary class="flex size-14 cursor-pointer list-none items-center justify-center rounded-2xl border border-base-300/70 bg-base-100/95 shadow-xl backdrop-blur-xl transition hover:-translate-y-0.5 hover:border-secondary [&::-webkit-details-marker]:hidden">
            <span class="flex size-10 items-center justify-center rounded-xl bg-primary text-xs font-bold uppercase text-primary-content">
              {String.first(@current_scope.user.first_name)}{String.first(
                @current_scope.user.last_name
              )}
            </span>
            <span class="sr-only">Open profile menu</span>
          </summary>
          <div class="absolute right-0 mt-3 w-64 max-w-[calc(100vw_-_2rem)] overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-2xl">
            <div class="border-b border-base-300 bg-base-200 px-5 py-4">
              <p class="truncate text-sm font-bold text-primary">
                {@current_scope.user.first_name} {@current_scope.user.last_name}
              </p>
              <p class="mt-1 break-all text-xs text-base-content/55">
                {@current_scope.user.email}
              </p>
            </div>
            <div class="p-2">
              <.link
                navigate={~p"/driving-preferences"}
                class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-primary transition hover:bg-base-200"
              >
                <.icon name="hero-adjustments-horizontal" class="size-5 text-secondary" />
                Driving preferences
              </.link>
              <.link
                navigate={~p"/profile"}
                class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-primary transition hover:bg-base-200"
              >
                <.icon name="hero-user-circle" class="size-5 text-secondary" /> Profile
              </.link>
              <.link
                :if={
                  WaziRoute.Accounts.has_permission?(
                    @current_scope.user,
                    "road_condition_evidence",
                    "review"
                  )
                }
                id="dashboard-admin-evidence-link"
                navigate={~p"/admin/evidence"}
                class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-primary transition hover:bg-base-200"
              >
                <.icon name="hero-shield-check" class="size-5 text-secondary" /> Evidence review
              </.link>
              <a
                href={~p"/discover"}
                class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-primary transition hover:bg-base-200"
              >
                <.icon name="hero-globe-alt" class="size-5 text-secondary" /> Discover Wazi
              </a>
              <.link
                href={~p"/users/log-out"}
                method="delete"
                class="flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-error transition hover:bg-error/10"
              >
                <.icon name="hero-arrow-right-start-on-rectangle" class="size-5" /> Log out
              </.link>
            </div>
          </div>
        </details>
      </div>

      <div class="relative h-full">
        <section
          id="planner-panel"
          phx-hook="PlannerPanel"
          data-state={@planner_state}
          data-collapsed={to_string(@sheet_collapsed)}
          class="wazi-planner-sheet absolute z-[600] flex flex-col overflow-hidden border border-primary-content/10 bg-primary/95 text-primary-content shadow-2xl backdrop-blur-xl"
          aria-labelledby="planner-title"
        >
          <button
            id="sheet-toggle"
            type="button"
            phx-click="toggle-sheet"
            aria-expanded={to_string(!@sheet_collapsed)}
            aria-controls="planner-content"
            class="relative flex min-h-12 w-full shrink-0 touch-none items-center justify-between gap-3 px-5 text-xs font-semibold text-primary-content/80 md:hidden"
          >
            <span>{if(@planner_state == :ready, do: "Route options", else: "Plan a drive")}</span>
            <span
              class="absolute top-2 left-1/2 h-1 w-10 -translate-x-1/2 rounded-full bg-primary-content/30"
              aria-hidden="true"
            ></span>
            <span class="flex items-center gap-2">
              {if(@sheet_collapsed, do: "Show details", else: "Show map")}
              <.icon
                name={if(@sheet_collapsed, do: "hero-chevron-up", else: "hero-chevron-down")}
                class="size-4"
              />
            </span>
          </button>
          <div
            id="planner-content"
            class="relative min-h-0 overflow-x-hidden overflow-y-auto overscroll-contain p-4 md:p-5"
          >
            <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
              <div class="absolute -right-16 -top-16 size-64 rounded-full border-[44px] border-accent/10">
              </div>
            </div>
            <div class="relative min-w-0">
              <div :if={@planner_state != :ready} class="flex items-start justify-between gap-5">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent">
                    Plan a drive
                  </p>
                  <h2 id="planner-title" class="mt-2 text-2xl font-bold sm:text-3xl">
                    Where are you headed?
                  </h2>
                </div>
                <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-base-100/10"><.icon
                  name="hero-map-pin"
                  class="size-6 text-accent"
                /></span>
              </div>

              <.form
                :if={@planner_state != :ready}
                for={@form}
                id="journey-form"
                class="mt-6"
                phx-submit="submit"
                phx-change="validate"
              >
                <div class="grid gap-4">
                  <div>
                    <label
                      for="journey_form_starting_point"
                      class="mb-1.5 block text-xs font-semibold text-primary-content/75"
                    >Starting point</label>
                    <.input
                      field={@form[:starting_point]}
                      type="text"
                      autocomplete="off"
                      placeholder="e.g. Ruaka, Nairobi"
                      spellcheck="false"
                      required
                    />
                  </div>
                  <div>
                    <label
                      for="journey_form_destination_point"
                      class="mb-1.5 block text-xs font-semibold text-primary-content/75"
                    >Destination</label>
                    <.input
                      field={@form[:destination_point]}
                      type="text"
                      autocomplete="off"
                      placeholder="e.g. Loresho, Nairobi"
                      spellcheck="false"
                      required
                    />
                  </div>
                </div>

                <.button
                  id="plan-route-button"
                  disabled={@planner_state == :loading}
                  phx-disable-with="Finding routes…"
                  class="mt-3 inline-flex min-h-12 w-full items-center justify-center gap-3 rounded-xl bg-secondary px-5 font-bold text-secondary-content shadow-[4px_4px_0_#e9ad45] transition hover:-translate-y-0.5 hover:bg-base-100 hover:text-primary disabled:cursor-wait disabled:opacity-70 motion-reduce:transform-none"
                >
                  Find routes <.icon name="hero-arrow-right" class="size-5" />
                </.button>
              </.form>

              <div class="mt-5 border-t border-primary-content/15 pt-5">
                <div
                  :if={@planner_state == :idle}
                  id="planner-idle"
                  class="flex items-center gap-3 text-xs leading-6 text-primary-content/55"
                >
                  <.icon name="hero-sparkles" class="size-5 shrink-0 text-accent" />
                  Enter two places to compare up to three possible driving routes.
                </div>

                <div
                  :if={@planner_state == :loading}
                  id="planner-loading"
                  role="status"
                  class="flex items-center gap-3 rounded-xl border border-primary-content/15 bg-base-100/5 p-5 text-sm font-semibold"
                >
                  <.icon name="hero-arrow-path" class="size-5 animate-spin text-accent" />
                  Looking across the road network…
                </div>

                <div
                  :if={@planner_state == :error}
                  id="planner-error"
                  role="alert"
                  class="flex items-start gap-3 rounded-xl border border-error/40 bg-error/15 p-5 text-sm leading-6"
                >
                  <.icon
                    name="hero-exclamation-triangle"
                    class="mt-0.5 size-5 shrink-0 text-accent"
                  />
                  <p>{@planner_error}</p>
                </div>

                <div :if={@planner_state == :ready} id="planner-results">
                  <button
                    id="back-to-search"
                    type="button"
                    phx-click="reset-search"
                    class="inline-flex min-h-10 items-center gap-2 rounded-xl px-2 text-sm font-semibold text-primary-content/75 transition hover:bg-base-100/10 hover:text-primary-content"
                  >
                    <.icon name="hero-arrow-left" class="size-4" /> Search again
                  </button>

                  <div class="mt-4">
                    <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent">
                      {@route_count} {if(@route_count == 1, do: "route", else: "distinct routes")}
                    </p>
                    <h2 id="planner-title" class="mt-2 text-2xl font-bold">Choose your way</h2>
                    <p class="mt-2 line-clamp-2 text-xs leading-5 text-primary-content/60">
                      {@origin.label} <span class="mx-1 text-accent">→</span> {@destination.label}
                    </p>
                  </div>

                  <div class="mt-4 md:hidden">
                    <div
                      id="route-tabs"
                      phx-update="stream"
                      role="tablist"
                      aria-label="Driving routes"
                      class="grid grid-cols-3 gap-2"
                    >
                      <button
                        :for={{id, route} <- @streams.route_tabs}
                        id={"tab-#{id}"}
                        type="button"
                        role="tab"
                        phx-click="select-route"
                        phx-value-route-id={route.id}
                        aria-selected={to_string(route.id == @selected_route_id)}
                        aria-controls="selected-route-details"
                        tabindex={if(route.id == @selected_route_id, do: "0", else: "-1")}
                        class={[
                          "min-h-16 min-w-0 rounded-xl border px-2 py-3 text-center transition",
                          if(route.id == @selected_route_id,
                            do: "border-accent bg-accent text-accent-content",
                            else:
                              "border-primary-content/20 bg-primary-content/5 text-primary-content/75"
                          )
                        ]}
                      >
                        <span class="block text-xs font-bold">{route_label(route.id)}</span>
                        <span class="mt-1 block text-[11px]">{format_duration(route.duration_s)}</span>
                      </button>
                    </div>
                    <div
                      id="selected-route-details"
                      role="tabpanel"
                      aria-labelledby={"tab-route_tabs-#{@selected_route_id}"}
                      class="mt-3 min-w-0 rounded-xl bg-base-100 p-4 text-base-content"
                    >
                      <div class="flex flex-wrap items-center justify-between gap-2">
                        <span
                          :if={@selected_route.recommended}
                          id="selected-route-recommended-badge"
                          class="inline-flex items-center gap-1.5 rounded-full bg-accent px-2.5 py-0.5 text-xs font-bold text-accent-content"
                        >
                          <.icon name="hero-sparkles" class="size-3.5" />
                          {@selected_route.recommendation_label || "Recommended"}
                        </span>
                        <span
                          :if={
                            !@selected_route.recommended && @selected_route.recommendation_label
                          }
                          class="inline-flex items-center gap-1.5 rounded-full bg-base-200 px-2.5 py-0.5 text-xs font-semibold text-base-content/70"
                        >
                          {@selected_route.recommendation_label}
                        </span>
                        <span
                          :if={@selected_route.score != nil}
                          class="text-xs font-semibold text-base-content/55"
                        >
                          Score: {@selected_route.score} min
                        </span>
                      </div>

                      <p class="mt-2 break-words text-sm font-semibold text-primary">
                        {format_via(@selected_route.via)}
                      </p>

                      <p
                        :if={@selected_route.explanation != nil}
                        id="selected-route-summary"
                        class="mt-1.5 text-xs leading-relaxed text-base-content/75"
                      >
                        {@selected_route.explanation.summary}
                      </p>

                      <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
                        <div>
                          <dt class="text-xs text-base-content/60">Distance</dt><dd class="font-bold">
                            {format_distance(@selected_route.distance_m)}
                          </dd>
                        </div>
                        <div>
                          <dt class="text-xs text-base-content/60">Time</dt><dd class="font-bold">
                            {format_duration(@selected_route.duration_s)}
                          </dd>
                        </div>
                      </dl>
                      <div id="route-evidence-summary" class="mt-4 border-t border-base-300 pt-4">
                        <p class="text-xs font-bold uppercase tracking-wide text-primary">
                          {evidence_coverage_label(@selected_route.evidence)}
                        </p>
                        <p
                          :if={
                            Map.get(@selected_route.evidence, :unknown_condition_roads, []) != []
                          }
                          class="mt-2 break-words text-xs leading-5 text-base-content/65"
                        >
                          Unknown condition: {Enum.join(
                            Map.get(@selected_route.evidence, :unknown_condition_roads, []),
                            " · "
                          )}
                        </p>
                        <p
                          :if={
                            Map.get(@selected_route.evidence, :known_condition_roads, []) != []
                          }
                          class="mt-2 break-words text-xs leading-5 text-base-content/65"
                        >
                          <span
                            :for={
                              evidence <-
                                Map.get(@selected_route.evidence, :known_condition_roads, [])
                            }
                            class="mr-2 inline-block"
                          >
                            {evidence.road_name}: {evidence_condition_label(evidence.condition)}
                          </span>
                        </p>
                        <p
                          id="route-traffic-summary"
                          class="mt-2 text-xs leading-5 text-base-content/50"
                        >
                          {traffic_status_label(Map.get(@selected_route.evidence, :traffic, %{}))}
                        </p>
                      </div>
                      <div id="route-elevation-summary" class="mt-4 border-t border-base-300 pt-4">
                        <p class="text-xs font-bold uppercase tracking-wide text-primary">
                          {elevation_status_label(
                            Map.get(@selected_route.evidence, :elevation, %{})
                          )}
                        </p>
                        <p
                          :if={
                            Map.get(Map.get(@selected_route.evidence, :elevation, %{}), :status) ==
                              :available
                          }
                          class="mt-2 text-xs leading-5 text-base-content/65"
                        >
                          {format_metres(
                            elevation_feature(
                              Map.get(@selected_route.evidence, :elevation, %{}),
                              :uphill_distance_m
                            )
                          )} uphill · {format_metres(
                            elevation_feature(
                              Map.get(@selected_route.evidence, :elevation, %{}),
                              :total_ascent_m
                            )
                          )} ascent · maximum estimated uphill grade {format_grade(
                            elevation_feature(
                              Map.get(@selected_route.evidence, :elevation, %{}),
                              :max_uphill_grade_percent
                            )
                          )}
                        </p>
                        <p class="mt-2 text-xs leading-5 text-base-content/50">
                          This is sampled terrain data, not a road-engineering measurement.
                        </p>
                      </div>

                      <div
                        :if={@selected_route.explanation != nil}
                        id="selected-route-why"
                        class="mt-4 border-t border-base-300 pt-4"
                      >
                        <button
                          id="toggle-why-selected-route"
                          type="button"
                          phx-click="toggle-why-route"
                          phx-value-route-id={@selected_route.id}
                          class="flex w-full items-center justify-between gap-2 rounded-xl bg-base-200/70 px-3.5 py-2.5 text-left text-xs font-bold text-primary transition hover:bg-base-200"
                        >
                          <span class="inline-flex items-center gap-2">
                            <.icon name="hero-light-bulb" class="size-4 text-accent" />
                            Why this route was suggested
                          </span>
                          <.icon
                            name={
                              if(@showing_why_route_id == @selected_route.id,
                                do: "hero-chevron-up",
                                else: "hero-chevron-down"
                              )
                            }
                            class="size-4 text-base-content/50"
                          />
                        </button>

                        <div
                          :if={@showing_why_route_id == @selected_route.id}
                          id={"why-details-#{@selected_route.id}"}
                          class="mt-3 space-y-3 rounded-xl border border-base-300/80 bg-base-200/40 p-3.5 text-xs"
                        >
                          <p class="font-bold text-primary text-sm">
                            {@selected_route.explanation.headline}
                          </p>
                          <p class="text-base-content/75 leading-relaxed">
                            {@selected_route.explanation.summary}
                          </p>

                          <div class="space-y-2 pt-1">
                            <p class="text-[10px] font-bold uppercase tracking-wider text-base-content/50">
                              Cited Evidence
                            </p>
                            <div
                              :for={factor <- @selected_route.explanation.cited_factors}
                              class={[
                                "flex items-start gap-2.5 rounded-lg border p-2.5 text-xs",
                                sentiment_badge_class(factor.sentiment)
                              ]}
                            >
                              <.icon
                                name={sentiment_icon(factor.sentiment)}
                                class="mt-0.5 size-4 shrink-0"
                              />
                              <div>
                                <p class="font-bold">{factor.label}</p>
                                <p class="mt-0.5 leading-snug">{factor.text}</p>
                              </div>
                            </div>
                          </div>

                          <div
                            :if={@selected_route.explanation.cautions != []}
                            class="rounded-lg bg-amber-50 border border-amber-200 p-2.5 text-amber-900"
                          >
                            <p class="font-bold text-[11px] flex items-center gap-1.5">
                              <.icon name="hero-information-circle" class="size-4 text-amber-700" />
                              Caution & Data Limits
                            </p>
                            <ul class="mt-1 list-disc list-inside space-y-0.5 text-[11px] text-amber-800">
                              <li :for={caution <- @selected_route.explanation.cautions}>
                                {caution}
                              </li>
                            </ul>
                          </div>

                          <div class="flex items-center justify-between border-t border-base-300/60 pt-2 text-[11px] text-base-content/60">
                            <span>Tailored for {@selected_route.explanation.vehicle_summary}</span>
                            <span
                              :if={@selected_route.score != nil}
                              class="font-semibold text-primary"
                            >Score: {@selected_route.score} min</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div id="candidate-routes" phx-update="stream" class="mt-5 hidden gap-3 md:grid">
                    <button
                      :for={{id, route} <- @streams.routes}
                      id={id}
                      type="button"
                      phx-click="select-route"
                      phx-value-route-id={route.id}
                      aria-pressed={to_string(route.id == @selected_route_id)}
                      class={[
                        "group w-full rounded-xl border p-4 text-left text-base-content transition hover:-translate-y-0.5 hover:shadow-lg motion-reduce:transform-none",
                        if(route.id == @selected_route_id,
                          do: "border-accent bg-base-100 shadow-[0_0_0_2px_#e9ad45]",
                          else: "border-transparent bg-base-100/90"
                        )
                      ]}
                    >
                      <div class="flex items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                          <span class={[
                            "flex size-10 shrink-0 items-center justify-center rounded-full transition",
                            if(route.id == @selected_route_id,
                              do: "bg-secondary text-secondary-content",
                              else: "bg-accent/25 text-secondary"
                            )
                          ]}>
                            <.icon name="hero-map" class="size-5" />
                          </span>
                          <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                              <h3 class="font-bold text-primary">{route_label(route.id)}</h3>
                              <span
                                :if={route.recommended}
                                class="rounded-full bg-accent px-2 py-0.5 text-[10px] font-bold text-accent-content"
                              >
                                {route.recommendation_label || "Recommended"}
                              </span>
                              <span
                                :if={!route.recommended && route.recommendation_label}
                                class="rounded-full bg-base-200 px-2 py-0.5 text-[10px] font-medium text-base-content/65"
                              >
                                {route.recommendation_label}
                              </span>
                            </div>
                            <p class="mt-1 break-words line-clamp-2 text-xs leading-5 text-base-content/60">
                              {format_via(route.via)}
                            </p>
                          </div>
                        </div>
                        <.icon
                          :if={route.id == @selected_route_id}
                          name="hero-check-circle"
                          class="size-5 shrink-0 text-secondary"
                        />
                      </div>
                      <dl class="mt-4 grid grid-cols-2 gap-4 border-t border-base-300 pt-4">
                        <div>
                          <dt class="text-[10px] uppercase tracking-wide text-base-content/45">
                            Distance
                          </dt>
                          <dd class="mt-1 text-sm font-bold text-primary">
                            {format_distance(route.distance_m)}
                          </dd>
                        </div>
                        <div>
                          <dt class="text-[10px] uppercase tracking-wide text-base-content/45">
                            Time
                          </dt>
                          <dd class="mt-1 text-sm font-bold text-primary">
                            {format_duration(route.duration_s)}
                          </dd>
                        </div>
                      </dl>
                      <p
                        :if={route.explanation != nil}
                        class="mt-2 text-xs leading-relaxed text-base-content/75 line-clamp-2"
                      >
                        {route.explanation.summary}
                      </p>
                      <p class="mt-3 text-xs font-semibold text-base-content/60">
                        {evidence_coverage_label(route.evidence)}
                      </p>
                      <p class="mt-1 text-xs text-base-content/50">
                        {elevation_status_label(Map.get(route.evidence, :elevation, %{}))}
                      </p>
                      <p class="mt-1 text-xs text-base-content/50">
                        {traffic_status_label(Map.get(route.evidence, :traffic, %{}))}
                      </p>

                      <div
                        :if={route.id == @selected_route_id and route.explanation != nil}
                        id={"candidate-why-#{route.id}"}
                        class="mt-3 border-t border-base-300 pt-3 text-left"
                      >
                        <div class="flex items-center justify-between">
                          <span class="inline-flex items-center gap-1.5 text-xs font-bold text-primary">
                            <.icon name="hero-light-bulb" class="size-4 text-accent" />
                            Why this route was suggested
                          </span>
                          <span
                            :if={route.score != nil}
                            class="text-[11px] font-semibold text-base-content/60"
                          >
                            Score: {route.score} min
                          </span>
                        </div>
                        <p class="mt-1.5 text-xs font-semibold text-primary">
                          {route.explanation.headline}
                        </p>
                        <div class="mt-2 space-y-1.5">
                          <div
                            :for={factor <- route.explanation.cited_factors}
                            class={[
                              "flex items-start gap-2 rounded-lg border p-2 text-xs",
                              sentiment_badge_class(factor.sentiment)
                            ]}
                          >
                            <.icon
                              name={sentiment_icon(factor.sentiment)}
                              class="mt-0.5 size-3.5 shrink-0"
                            />
                            <span class="leading-snug">{factor.text}</span>
                          </div>
                        </div>
                        <div
                          :if={route.explanation.cautions != []}
                          class="mt-2 rounded-lg border border-amber-200 bg-amber-50 p-2 text-[11px] text-amber-900"
                        >
                          <p
                            :for={caution <- route.explanation.cautions}
                            class="flex items-start gap-1"
                          >
                            <.icon
                              name="hero-information-circle"
                              class="mt-0.5 size-3.5 shrink-0 text-amber-700"
                            />
                            <span>{caution}</span>
                          </p>
                        </div>
                      </div>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <aside class="absolute inset-0">
          <section
            id="route-map-panel"
            class="relative h-full overflow-hidden bg-base-200"
            aria-label="Route map"
          >
            <div
              id="route-map"
              phx-hook="RouteMap"
              phx-update="ignore"
              class="wazi-route-map absolute inset-0 z-0"
              role="application"
              aria-label="Interactive route map"
            >
            </div>

            <div
              :if={@planner_state == :loading}
              id="map-loading"
              class="absolute top-24 right-4 z-[500] flex max-w-[calc(100%_-_2rem)] items-center gap-3 rounded-xl bg-base-100/95 p-3 text-xs font-semibold text-primary shadow-lg backdrop-blur md:top-auto md:right-8 md:bottom-24 md:text-sm"
            >
              <.icon name="hero-arrow-path" class="size-5 animate-spin text-secondary" />
              Preparing your route map…
            </div>
          </section>
        </aside>
      </div>
    </div>
  </section>
</Layouts.app>
