<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="min-h-[calc(100dvh-5rem)] bg-stone-50 px-5 py-10 sm:px-8 lg:px-12 lg:py-14">
    <div class="mx-auto max-w-6xl">
      <div class="rounded-3xl bg-primary px-6 py-8 text-primary-content shadow-xl sm:px-9 sm:py-10">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-accent">
              Admin workspace
            </p>
            <h1 id="evidence-review-title" class="mt-3 text-3xl font-bold sm:text-4xl">
              Road evidence review
            </h1>
            <p class="mt-3 text-sm leading-6 text-primary-content/75 sm:text-base">
              Inspect source provenance before a condition becomes part of a route recommendation.
              Approval is deliberate and reversible through a recorded rejection.
            </p>
          </div>
          <div class="rounded-2xl border border-primary-content/20 bg-primary-content/10 px-5 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-primary-content/65">
              Stored records
            </p>
            <p id="evidence-count" class="mt-1 text-3xl font-bold">{@evidence_count}</p>
          </div>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 px-5 py-4 text-sm leading-6 text-amber-950">
        <div class="flex gap-3">
          <.icon name="hero-information-circle" class="mt-0.5 size-5 shrink-0 text-amber-700" />
          <p>
            OpenStreetMap imports begin unverified. Check that the source way covers the affected
            corridor and that its tags support the condition before approving it. Automatic expiry
            is deliberately disabled until the revalidation policy's pilot gates are met.
          </p>
        </div>
      </div>

      <section
        id="osm-collection"
        class="mt-8 overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm"
        aria-labelledby="osm-collection-title"
      >
        <div class="border-b border-base-300 bg-base-200/70 px-5 py-5 sm:px-6">
          <div class="flex items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-secondary/15 text-secondary">
              <.icon name="hero-arrow-down-tray" class="size-5" />
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-secondary">Collect source</p>
              <h2 id="osm-collection-title" class="mt-1 text-xl font-bold text-primary">
                Queue an OpenStreetMap road record
              </h2>
              <p class="mt-1 max-w-3xl text-sm leading-6 text-base-content/65">
                Paste a public OSM way link. Wazi fetches the current source tags, accepts only
                supported condition signals, and queues the record as unverified for your review.
              </p>
            </div>
          </div>
        </div>
        <.form
          for={@collect_form}
          id="osm-collection-form"
          class="grid gap-4 px-5 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end sm:px-6"
          phx-submit="collect-osm"
        >
          <.input
            field={@collect_form[:source_url]}
            type="url"
            label="OpenStreetMap way URL"
            placeholder="https://www.openstreetmap.org/way/703287964"
            required
            autocomplete="url"
          />
          <.button
            id="collect-osm-button"
            phx-disable-with="Collecting…"
            class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-primary px-5 text-sm font-bold text-primary-content transition hover:-translate-y-0.5 hover:bg-secondary hover:text-secondary-content hover:shadow-md motion-reduce:transform-none"
          >
            <.icon name="hero-arrow-down-tray" class="size-4" /> Collect record
          </.button>
        </.form>
      </section>

      <div id="evidence-list" class="mt-8 space-y-5" phx-update="stream">
        <div
          id="evidence-empty-state"
          class="hidden rounded-2xl border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center only:block"
        >
          <.icon name="hero-inbox" class="mx-auto size-9 text-base-content/35" />
          <p class="mt-3 font-semibold text-primary">No evidence has been imported.</p>
          <p class="mt-1 text-sm text-base-content/60">
            Collect an OpenStreetMap way above to begin a review.
          </p>
        </div>

        <article
          :for={{id, evidence} <- @streams.evidence}
          id={id}
          class="overflow-hidden rounded-2xl border border-base-300 bg-base-100 shadow-sm transition hover:border-secondary/45 hover:shadow-md"
        >
          <div class="flex flex-col gap-5 px-5 py-5 sm:px-6 sm:py-6 lg:flex-row lg:items-start lg:justify-between">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class={[
                  "rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide",
                  status_class(evidence.verification_status)
                ]}>
                  {evidence.verification_status}
                </span>
                <span class="rounded-full bg-base-200 px-3 py-1 text-xs font-semibold text-base-content/65">
                  {condition_label(evidence.condition)} condition
                </span>
              </div>

              <h2 class="mt-4 text-xl font-bold text-primary">{evidence.road_name}</h2>
              <p class="mt-1 text-sm text-base-content/60">
                {evidence.import_key || evidence.source_reference}
              </p>

              <dl class="mt-5 grid gap-4 text-sm sm:grid-cols-2 xl:grid-cols-4">
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/45">
                    Observed
                  </dt>
                  <dd class="mt-1 font-medium text-base-content/80">
                    {format_timestamp(evidence.observed_at)}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/45">
                    Retrieved
                  </dt>
                  <dd class="mt-1 font-medium text-base-content/80">
                    {format_timestamp(evidence.retrieved_at)}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/45">
                    Confidence
                  </dt>
                  <dd class="mt-1 font-medium text-base-content/80">
                    {Decimal.round(evidence.confidence, 2)}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-base-content/45">
                    Source type
                  </dt>
                  <dd class="mt-1 font-medium capitalize text-base-content/80">
                    {evidence.source_type}
                  </dd>
                </div>
              </dl>

              <div class="mt-5 rounded-xl bg-base-200/70 px-4 py-3 text-xs leading-5 text-base-content/70">
                <p class="font-semibold uppercase tracking-wide text-base-content/50">
                  Source tags
                </p>
                <p class="mt-1 break-words">{source_tags(evidence)}</p>
              </div>

              <a
                href={evidence.source_reference}
                target="_blank"
                rel="noreferrer"
                class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-secondary transition hover:text-primary"
              >
                Open source record <.icon name="hero-arrow-top-right-on-square" class="size-4" />
              </a>
            </div>

            <div
              :if={evidence.verification_status == "unverified"}
              class="flex shrink-0 gap-3 lg:flex-col"
            >
              <button
                id={"approve-evidence-#{evidence.id}"}
                type="button"
                phx-click="review"
                phx-value-import-key={evidence.import_key}
                phx-value-decision="verified"
                class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl bg-emerald-700 px-4 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:bg-emerald-800 hover:shadow-md motion-reduce:transform-none lg:min-w-31"
              >
                <.icon name="hero-check" class="size-4" /> Approve
              </button>
              <button
                id={"reject-evidence-#{evidence.id}"}
                type="button"
                phx-click="review"
                phx-value-import-key={evidence.import_key}
                phx-value-decision="rejected"
                class="inline-flex min-h-11 flex-1 items-center justify-center gap-2 rounded-xl border border-rose-200 bg-rose-50 px-4 text-sm font-bold text-rose-800 transition hover:-translate-y-0.5 hover:bg-rose-100 hover:shadow-sm motion-reduce:transform-none lg:min-w-31"
              >
                <.icon name="hero-x-mark" class="size-4" /> Reject
              </button>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>
</Layouts.app>
