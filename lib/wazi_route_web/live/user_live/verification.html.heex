<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="wazi-pattern-light min-h-[calc(100dvh-5rem)] px-5 py-12 sm:px-8 lg:py-16">
    <div class="mx-auto grid max-w-6xl overflow-hidden rounded-[2rem] border border-base-300 bg-base-100 shadow-xl lg:grid-cols-[.85fr_1.15fr]">
      <div class="wazi-pattern relative hidden overflow-hidden p-10 text-primary-content lg:flex lg:flex-col lg:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent">Almost there</p>
          <h1 class="mt-5 text-5xl leading-[1.05] font-bold">
            One small step before the road opens up.
          </h1>
        </div>
        <div class="mt-16 rounded-2xl border border-primary-content/15 bg-base-100/10 p-6 backdrop-blur-sm">
          <.icon name="hero-shield-check" class="size-8 text-accent" />
          <p class="mt-4 text-sm leading-7 text-primary-content/75">
            Email verification protects your account and makes sure important route updates reach the right driver.
          </p>
        </div>
      </div>

      <div class="p-6 sm:p-10 lg:p-14">
        <div class="flex size-14 items-center justify-center rounded-2xl bg-accent/25 text-secondary">
          <.icon name="hero-envelope-open" class="size-7" />
        </div>
        <p class="mt-7 text-xs font-bold uppercase tracking-[0.1em] text-secondary">
          Check your inbox
        </p>
        <h1 id="verification-title" class="mt-3 text-3xl font-bold text-primary sm:text-4xl">
          Verify your email.
        </h1>
        <p class="mt-4 max-w-lg text-sm leading-7 text-base-content/65">
          Enter the 6-digit code sent to <strong class="font-bold text-primary">{@user.email}</strong>. It expires in 10 minutes.
        </p>

        <.form for={@form} id="verification-form" phx-submit="verify" class="mt-8">
          <.input
            field={@form[:code]}
            type="text"
            label="Verification code"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            minlength="6"
            maxlength="6"
            placeholder="000000"
            class="mt-2 min-h-16 w-full rounded-xl border border-base-300 bg-base-100 px-5 text-center font-mono text-3xl font-bold tracking-[0.35em] text-primary shadow-sm transition placeholder:text-base-content/20 focus:border-secondary focus:outline-none focus:ring-3 focus:ring-secondary/15"
            required
            phx-mounted={JS.focus()}
          />

          <p
            :if={@verification_error}
            id="verification-error"
            class="mt-3 flex items-start gap-2 rounded-xl bg-error/10 p-4 text-sm leading-6 text-error"
            role="alert"
          >
            <.icon name="hero-exclamation-circle" class="mt-0.5 size-5 shrink-0" />
            {@verification_error}
          </p>

          <.button
            phx-disable-with="Verifying..."
            class="mt-5 inline-flex min-h-13 w-full items-center justify-center gap-3 rounded-lg bg-secondary px-5 font-bold text-secondary-content transition hover:bg-primary"
          >
            Verify email <.icon name="hero-arrow-right" class="size-5" />
          </.button>
        </.form>

        <div class="mt-7 border-t border-base-300 pt-6 text-sm text-base-content/65">
          Didn't receive it?
          <button
            id="resend-verification-code"
            type="button"
            phx-click="resend"
            phx-disable-with="Sending..."
            class="ml-1 min-h-11 font-bold text-secondary hover:underline"
          >
            Send a new code
          </button>
          <p class="mt-1 text-xs text-base-content/50">
            New codes are available after 60 seconds.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
