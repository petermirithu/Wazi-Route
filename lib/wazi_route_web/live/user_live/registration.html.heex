<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="wazi-pattern-light min-h-[calc(100dvh-5rem)] px-5 py-12 sm:px-8 lg:py-16">
    <div class="mx-auto grid max-w-6xl overflow-hidden rounded-[2rem] border border-base-300 bg-base-100 shadow-xl lg:grid-cols-[.85fr_1.15fr]">
      <div class="wazi-pattern relative hidden overflow-hidden p-10 text-primary-content lg:flex lg:flex-col lg:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.1em] text-accent">
            Join the road ahead
          </p><h1 class="mt-5 text-5xl leading-[1.05] font-bold">
            Better routes start with what matters to you.
          </h1>
        </div>
        <div class="mt-16 rounded-2xl border border-primary-content/15 bg-base-100/10 p-6 backdrop-blur-sm">
          <.icon name="hero-map" class="size-8 text-accent" /><p class="mt-4 text-sm leading-7 text-primary-content/75">
            Help shape route choices that understand the car, the road, and the person behind the wheel.
          </p>
        </div>
      </div>
      <div class="p-6 sm:p-10 lg:p-14">
        <p class="text-xs font-bold uppercase tracking-[0.1em] text-secondary">Register</p>
        <h1 id="registration-title" class="mt-3 text-3xl font-bold text-primary sm:text-4xl">
          Welcome to Wazi.
        </h1>
        <p class="mt-3 text-sm leading-7 text-base-content/65">
          Already registered? <.link
            navigate={~p"/users/log-in"}
            class="font-bold text-secondary hover:underline"
          >Log in</.link>.
        </p>
        <.form
          for={@form}
          id="registration_form"
          phx-submit="save"
          phx-change="validate"
          class="mt-8 space-y-4"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <.input
              field={@form[:first_name]}
              type="text"
              label="First name"
              autocomplete="given-name"
              spellcheck="false"
              placeholder="e.g. John"
              required
              phx-mounted={JS.focus()}
            />
            <.input
              field={@form[:last_name]}
              type="text"
              label="Last name"
              autocomplete="family-name"
              spellcheck="false"
              placeholder="e.g. Doe"
              required
            />
          </div>
          <.input
            field={@form[:email]}
            type="email"
            label="Email address"
            autocomplete="username"
            spellcheck="false"
            placeholder="you@example.com"
            required
          />
          <div class="grid gap-4 sm:grid-cols-2">
            <.input
              field={@form[:password]}
              type="password"
              label="Password"
              autocomplete="new-password"
              placeholder="At least 8 characters"
              required
              phx-debounce="blur"
            />
            <.input
              field={@form[:password_confirmation]}
              type="password"
              label="Confirm password"
              autocomplete="new-password"
              placeholder="Repeat your password"
              required
              phx-debounce="blur"
            />
          </div>
          <.button
            phx-disable-with="Creating account..."
            class="mt-3 inline-flex min-h-13 w-full items-center justify-center gap-3 rounded-lg bg-secondary px-5 font-bold text-secondary-content transition hover:bg-primary"
          >Create my account <.icon name="hero-arrow-right" class="size-5" /></.button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>
