<Layouts.app flash={@flash} current_scope={@current_scope}>
  <section class="wazi-pattern-light min-h-[calc(100dvh-5rem)] px-5 py-14 sm:px-8">
    <div class="mx-auto max-w-xl overflow-hidden rounded-[2rem] border border-base-300 bg-base-100 shadow-xl">
      <div class="wazi-pattern px-7 py-10 text-center text-primary-content sm:px-12">
        <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-accent text-accent-content"><.icon
          name="hero-check"
          class="size-8"
        /></span><p class="mt-6 text-xs font-bold uppercase tracking-[0.18em] text-accent">
          One last turn
        </p><h1 id="confirmation-title" class="mt-3 text-3xl font-bold">
          Welcome, {@user.email}
        </h1>
      </div>
      <div class="p-7 sm:p-10">
        <.form
          :if={!@user.confirmed_at}
          for={@form}
          id="confirmation_form"
          phx-mounted={JS.focus_first()}
          phx-submit="submit"
          action={~p"/users/log-in?_action=confirmed"}
          phx-trigger-action={@trigger_submit}
          class="space-y-3"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
          <.button
            name={@form[:remember_me].name}
            value="true"
            phx-disable-with="Confirming..."
            class="inline-flex min-h-13 w-full items-center justify-center rounded-lg bg-secondary px-5 font-bold text-secondary-content hover:bg-primary"
          >Confirm and stay logged in</.button>
          <.button
            phx-disable-with="Confirming..."
            class="inline-flex min-h-12 w-full items-center justify-center rounded-lg border border-primary px-5 font-bold text-primary hover:bg-base-200"
          >Confirm for this session only</.button>
        </.form>
        <.form
          :if={@user.confirmed_at}
          for={@form}
          id="login_form"
          phx-submit="submit"
          phx-mounted={JS.focus_first()}
          action={~p"/users/log-in"}
          phx-trigger-action={@trigger_submit}
          class="space-y-3"
        >
          <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
          <%= if @current_scope do %>
            <.button
              phx-disable-with="Logging in..."
              class="inline-flex min-h-13 w-full items-center justify-center rounded-lg bg-primary px-5 font-bold text-primary-content"
            >Log in</.button>
          <% else %>
            <.button
              name={@form[:remember_me].name}
              value="true"
              phx-disable-with="Logging in..."
              class="inline-flex min-h-13 w-full items-center justify-center rounded-lg bg-secondary px-5 font-bold text-secondary-content hover:bg-primary"
            >Keep me logged in on this device</.button><.button
              phx-disable-with="Logging in..."
              class="inline-flex min-h-12 w-full items-center justify-center rounded-lg border border-primary px-5 font-bold text-primary hover:bg-base-200"
            >Log in for this session only</.button>
          <% end %>
        </.form>
        <p
          :if={!@user.confirmed_at}
          class="mt-7 flex gap-3 rounded-xl bg-accent/20 p-4 text-sm leading-6"
        >
          <.icon name="hero-light-bulb" class="size-5 shrink-0 text-secondary" />Prefer passwords? Enable one later in account settings.
        </p>
      </div>
    </div>
  </section>
</Layouts.app>
